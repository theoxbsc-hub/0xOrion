<?xml version="1.0" encoding="UTF-8"?>
<!-- Quiet console: hide RuneLite chatter. 0x status goes through OxConsole, not SLF4J. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %-18logger{0} %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Prefer OxConsole for ox status; only surface warn/error from plugins -->
  <logger name="net.runelite.client.plugins.ox" level="WARN"/>
  <logger name="net.runelite" level="WARN"/>
  <logger name="net.unethicalite" level="WARN"/>
  <logger name="org.slf4j" level="ERROR"/>
  <logger name="io.reactivex" level="ERROR"/>
  <logger name="okhttp3" level="ERROR"/>
  <logger name="com.google" level="ERROR"/>
  <logger name="ch.qos.logback" level="ERROR"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
